#!/usr/bin/env zsh

generate_only=false
agent="claude"

if [[ "$1" == "--generate" ]]; then
  generate_only=true
  shift
fi

if [[ "$1" == "--agent" ]]; then
  case "$2" in
    claude|pi) agent="$2" ;;
    *) echo "Unknown agent '$2'. Use 'claude' or 'pi'."; exit 1 ;;
  esac
fi

if git diff --cached --quiet; then
  echo "No staged changes to commit."
  exit 1
fi

instructions="You are a git commit message generator following Conventional Commits specification.

Generate a multi-line commit message with:
1. Subject line: <type>(<optional scope>): <description>
   - type: feat, fix, docs, style, refactor, test, chore, build, ci, perf
   - lowercase, concise, no period at end, under 72 characters
2. A blank line
3. A body with 2-5 bullet points summarising what changed and why (focus on WHAT and WHY, not HOW)
   - Each bullet starts with \"- \"
   - Group related changes together

Rules: no markdown, no quotes, no code fences. Respond with the commit message only.

Staged diff:"

message=""
if [[ "$agent" == "claude" ]]; then
  message=$( { print -r -- "$instructions"; git diff --cached; } | claude -p )
else
  prompt="$instructions
\"$(git diff --cached)\""
  message=$(pi -p --no-session "$prompt")
fi

if [[ -z "$message" ]]; then
  echo "Failed to generate message. Aborting."
  exit 1
fi

if $generate_only; then
  echo "$message"
  exit 0
fi

printf '\nGenerated message:\n  %s\n\n' "$message"
echo -n "[y] commit  [e] edit  [n] abort: "
read -r action

case "$action" in
  y|Y)
    git commit -m "$message"
    ;;
  e|E)
    tmp=$(mktemp /tmp/aic.XXXXXX)
    printf '%s' "$message" > "$tmp"
    "${EDITOR:-vim}" "$tmp"
    edited=$(< "$tmp")
    rm -f "$tmp"
    [[ -z "$edited" ]] && { echo "Empty message. Aborting."; exit 1; }
    git commit -m "$edited"
    ;;
  *)
    echo "Aborted."
    exit 1
    ;;
esac
